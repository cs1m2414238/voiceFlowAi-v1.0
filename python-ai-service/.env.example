# VoiceFlow AI - Python AI Service Environment Configuration
APP_NAME="VoiceFlow AI"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.0

# RAG / ChromaDB
CHROMA_PERSIST_DIR=./chroma_test_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_FAQ_PDF=./company_faq.pdf

# Java Spring Boot Backend Integration
JAVA_BACKEND_URL=http://localhost:8080
JAVA_BACKEND_TIMEOUT=3.0
JAVA_SYNC_ENABLED=false

# Security (leave empty to disable X-API-Key header check in local dev)
API_KEY=

# Speech Processing
MAX_AUDIO_SIZE_MB=25
DEFAULT_TTS_VOICE=Rachel
DEFAULT_STT_LANGUAGE=en
